{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "B2BClientVendorProfile",
  "description": "Comprehensive schema and mock dataset for international B2B Client/Vendor profile and media assets modeled after go4WorldBusiness, Alibaba, and Global Sources.",
  "type": "object",
  "required": [
    "id",
    "companyName",
    "legalRegistrationNumber",
    "country",
    "city",
    "establishedYear",
    "businessType",
    "tier",
    "logoUrl",
    "bannerUrl",
    "products",
    "complianceCertificates",
    "factoryDetails"
  ],
  "properties": {
    "id": { "type": "string", "example": "comp-apex-motorsport" },
    "companyName": { "type": "string", "example": "Apex Dynamics Precision Forging & Motorsport Ltd." },
    "tradeName": { "type": "string", "example": "Apex Dynamics Racing Systems" },
    "legalRegistrationNumber": { "type": "string", "example": "US-IN-2006-LLC-884920" },
    "country": { "type": "string", "example": "United States" },
    "city": { "type": "string", "example": "Indianapolis, IN" },
    "address": { "type": "string", "example": "4200 Speedway Boulevard, Indianapolis, IN 46222" },
    "establishedYear": { "type": "integer", "example": 2006 },
    "businessType": { "type": "string", "example": "Manufacturer" },
    "tier": { "type": "string", "example": "VIP" },
    "isVerifiedKYC": { "type": "boolean", "example": true },
    "trustScore": { "type": "number", "example": 98.4 },
    "responseRate": { "type": "string", "example": "99.2%" },
    "avgResponseTime": { "type": "string", "example": "< 1 hour" },
    "totalEmployees": { "type": "string", "example": "350 - 500 Staff" },
    "annualRevenueUsd": { "type": "string", "example": "$45M - $75M USD" },
    "tradeAssuranceLimitUsd": { "type": "number", "example": 2500000 },
    "completedOrdersCount": { "type": "integer", "example": 520 },
    "logoUrl": { "type": "string", "example": "https://images.unsplash.com/photo-1580273916550-e323be2ae537?w=400&auto=format&fit=crop&q=80" },
    "bannerUrl": { "type": "string", "example": "https://images.unsplash.com/photo-1552519507-da3b142c6e3d?w=1600&auto=format&fit=crop&q=80" }
  }
}
