# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_EMAIL: Authorized corporate email for Master Platform Administrator.
ADMIN_EMAIL="admin@tradeheaven.net"

# ADMIN_PASSWORD: Secure password for Master Platform Administrator authentication.
ADMIN_PASSWORD="TradeHeavenAdmin2025!"

# SMTP Configuration for Automated Password Reset OTPs (noreply@tradeheaven.net) & Security Alerts
NOREPLY_SMTP_HOST="mail.tradeheaven.net"
NOREPLY_SMTP_PORT=465
NOREPLY_SMTP_USER="noreply@tradeheaven.net"
NOREPLY_SMTP_PASS="YOUR_NOREPLY_SMTP_PASSWORD"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="noreply@tradeheaven.net"
SMTP_PASS="YOUR_SMTP_PASSWORD"
# Comma-separated list of notification recipients
ALERT_EMAIL="solutionthe87@gmail.com"
