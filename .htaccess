<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Preserve Authorization header for PHP FastCGI/CGI Bearer token verification
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Route Node-compatible auth endpoints directly to api.php on Apache/cPanel hosts
  RewriteRule ^api/v1/auth/([^/]+)/?$ /api.php?action=$1 [QSA,L,NC]

  RewriteCond %{REQUEST_URI} ^/api\.php [NC]
  RewriteRule ^ - [L]

  # Allow direct access to existing files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Do NOT rewrite static assets to index.html (missing hashed chunks must return 404, never text/html)
  RewriteCond %{REQUEST_URI} \.(js|mjs|css|png|jpg|jpeg|gif|webp|svg|woff|woff2|ttf|eot|ico|json)$ [NC,OR]
  RewriteCond %{REQUEST_URI} ^/assets/ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ - [R=404,L]

  # Fallback client routes to index.html for React SPA Routing
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"

  # Prevent browsers (especially normal Chrome) from caching index.html after deployments
  <FilesMatch "^(index\.html)?$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Long-term immutable caching for hashed JavaScript, CSS, and web assets in /assets/
  <FilesMatch "\.(js|mjs|css|woff2|webp|jpg|jpeg|png)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
