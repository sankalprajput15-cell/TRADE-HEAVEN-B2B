<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Preserve Authorization header for PHP FastCGI/CGI Bearer token verification
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Route Node-compatible auth endpoints directly to api.php on Apache/cPanel hosts
  RewriteRule ^api/v1/auth/([^/]+)/?$ /api.php?action=$1 [QSA,L,NC]

  # Allow direct access to api.php without rewriting to index.html
  RewriteRule ^api\.php$ - [L]

  # Allow direct access to existing files, folders, or assets
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback all client routes to index.html for React SPA Routing
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
</IfModule>
