rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS & AUTHENTICATION VALIDATORS
    // =========================================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'ADMIN' ||
        getUserData().role == 'ADMIN' ||
        request.auth.token.email.matches('.*@tradeheaven\\.net$')
      );
    }
    
    function isPremiumMember() {
      return isAuthenticated() && (
        isAdmin() ||
        request.auth.token.isPremium == true ||
        getUserData().isPremium == true ||
        getUserData().membershipStatus == 'paid'
      );
    }

    // List of system authorization and compliance fields protected from self-modification
    function modifiesSystemFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'role',
        'status',
        'isVerified',
        'isVerifiedKYC',
        'isPremium',
        'membershipStatus',
        'tier',
        'plan',
        'tradeAssuranceLimitUsd',
        'trustScore',
        'kycVerificationDate'
      ]);
    }

    // =========================================================================
    // 1. USERS COLLECTION
    // =========================================================================
    match /users/{userId} {
      // Any authenticated user can read basic public profile info
      allow read: if isAuthenticated();
      
      // User can create their initial profile upon registration
      allow create: if isOwner(userId) && (
        !request.resource.data.keys().hasAny(['role', 'isPremium', 'isVerified']) ||
        request.resource.data.role == 'BUYER' ||
        request.resource.data.role == 'SUPPLIER'
      );
      
      // Self-update allowed ONLY if protected system fields are untouched.
      // Admins have unrestricted update rights.
      allow update: if isAdmin() || (
        isOwner(userId) && 
        !modifiesSystemFields()
      );
      
      // Deletions strictly restricted to Admins
      allow delete: if isAdmin();

      // Private contact and billing subcollection (gated to Owner & Admin)
      match /private_billing/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // =========================================================================
    // 2. SUPPLIERS & COMPANY DIRECTORY
    // =========================================================================
    match /companies/{companyId} {
      // Public catalog information is readable
      allow read: if true;
      
      // Only company owner or Admin can create/update company profile
      allow create: if isAuthenticated() && (
        request.resource.data.ownerUid == request.auth.uid || isAdmin()
      );
      
      allow update: if isAdmin() || (
        isAuthenticated() && 
        resource.data.ownerUid == request.auth.uid &&
        !modifiesSystemFields()
      );
      
      allow delete: if isAdmin();

      // Direct Contact Vault (Phone, direct WhatsApp, export email)
      // Strictly gated to verified Paid Premium members or Admins
      match /direct_contacts/{contactId} {
        allow read: if isPremiumMember();
        allow write: if isAdmin() || (
          isAuthenticated() && get(/databases/$(database)/documents/companies/$(companyId)).data.ownerUid == request.auth.uid
        );
      }
    }

    // =========================================================================
    // 3. RFQS & BUY LEADS
    // =========================================================================
    match /rfqs/{rfqId} {
      // All authenticated users can browse RFQs
      allow read: if isAuthenticated();
      
      // Verified buyers can create RFQs
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      
      // Only creator or admin can update their RFQ
      allow update: if isAdmin() || (
        isAuthenticated() && 
        resource.data.ownerUid == request.auth.uid &&
        !modifiesSystemFields()
      );
      
      allow delete: if isAdmin() || (
        isAuthenticated() && resource.data.ownerUid == request.auth.uid
      );

      // Direct Buyer Contact & Phone
      match /buyer_contacts/{contactId} {
        allow read: if isPremiumMember() || (isAuthenticated() && get(/databases/$(database)/documents/rfqs/$(rfqId)).data.ownerUid == request.auth.uid);
        allow write: if isAdmin() || (isAuthenticated() && get(/databases/$(database)/documents/rfqs/$(rfqId)).data.ownerUid == request.auth.uid);
      }
    }

    // =========================================================================
    // 4. PRIVATE BUSINESS DATA (ORDERS, ESCROWS, NEGOTIATIONS)
    // =========================================================================
    match /escrows/{escrowId} {
      // Restricted strictly to involved Buyer, involved Supplier, or Admin
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.buyerUid == request.auth.uid ||
        resource.data.supplierUid == request.auth.uid
      );
      
      allow create: if isAuthenticated() && (
        isAdmin() || request.resource.data.buyerUid == request.auth.uid
      );
      
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.buyerUid == request.auth.uid ||
        resource.data.supplierUid == request.auth.uid
      );
      
      allow delete: if isAdmin();
    }

    match /negotiations/{negotiationId} {
      // Direct messaging and negotiations restricted to involved participants
      allow read, write: if isAuthenticated() && (
        isAdmin() ||
        resource.data.buyerUid == request.auth.uid ||
        resource.data.supplierUid == request.auth.uid ||
        request.resource.data.buyerUid == request.auth.uid
      );
    }

    // =========================================================================
    // 5. ADMIN AUDIT & TREASURY CONFIGURATIONS
    // =========================================================================
    match /admin_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated(); // Automated system logging
      allow update, delete: if false; // Append-only immutable log
    }

    match /bank_accounts/{accountId} {
      allow read: if isAuthenticated(); // For wire settlement instructions
      allow write: if isAdmin(); // Only admins can alter depository accounts
    }

    match /paid_clients/{clientId} {
      allow read, write: if isAdmin();
    }
  }
}
